---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Stat from "../components/Stat.astro";
import Stack from "../components/Stack.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { SITE } from "../data/site";
import { PROJECTS } from "../data/projects";
import { STACK } from "../data/stack";
import { TECH_META } from "../data/tech";

const years = new Date().getFullYear() - SITE.since;
const techCount = new Set(
	STACK.flatMap((category) => category.items.map((i) => i.tech)),
).size;
const projectCount = PROJECTS.filter((project) => !project.draft).length;
---

<Layout
	title="Sergio Vallenari, Fullstack Developer"
	description="Sergio Vallenari - Fullstack Developer. Desarrollo aplicaciones web modernas con React, TypeScript, Node.js y bases de datos SQL."
>
	<div class="mx-auto max-w-shell px-5 sm:px-8">
		<section
			class="grid items-center gap-12 pb-16 pt-14 sm:pt-20 lg:grid-cols-12 lg:gap-10 lg:pb-24 lg:pt-28"
		>
			<div class="lg:col-span-7">
				<p
					class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-mute"
				>
					<span class="size-1.5 rounded-full bg-available"></span>
					{SITE.availability}
				</p>
				<h1
					class="mt-7 text-balance text-[clamp(2.75rem,7vw,5.25rem)] font-semibold leading-[0.95] tracking-[-0.035em] text-ink"
				>
					Hola, soy Sergio.<br />
					<span class="text-ink-mute">Fullstack developer.</span>
				</h1>
				<p
					class="mt-8 max-w-[54ch] text-lg leading-relaxed text-ink-soft"
				>
					{SITE.tagline}
				</p>
				<div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
					<a
						href="/proyectos"
						class="inline-flex items-center gap-2 bg-ink px-6 py-3 text-sm font-medium text-paper transition-colors duration-300 hover:bg-accent"
					>
						Ver proyectos
						<svg
							aria-hidden="true"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="size-4"
						>
							<path d="M5 12h14"></path>
							<path d="m13 6 6 6-6 6"></path>
						</svg>
					</a>
					<ArrowLink href="/contacto">Hablemos</ArrowLink>
					<ArrowLink href={SITE.cv} external>Descargar CV</ArrowLink>
				</div>
			</div>

			<div class="lg:col-span-5">
				<div class="relative mx-auto max-w-sm lg:ml-auto lg:mr-0">
					<span
						aria-hidden="true"
						class="absolute -bottom-4 -right-4 -z-10 hidden h-full w-full border border-line sm:block"
					></span>
					<img
						src={SITE.about.heroImage}
						alt="Sergio Vallenari"
						width="480"
						height="600"
						loading="eager"
						class="aspect-[4/5] ml-4 w-full object-cover grayscale-[35%] rounded"
					/>
					<p
						class="mt-4 ml-10 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-mute"
					>
						Sergio Vallenari — {SITE.role}
					</p>
				</div>
			</div>
		</section>

		<div class="grid gap-x-8 border-t border-line sm:grid-cols-3">
			<div class="border-b border-line sm:border-b-0 sm:border-r sm:pr-8">
				<Stat value={`+${years}`} label="Años programando" />
			</div>
			<div class="border-b border-line sm:border-b-0 sm:border-r sm:px-8">
				<Stat
					value={String(projectCount).padStart(2, "0")}
					label="Proyectos"
				/>
			</div>
			<div class="sm:pl-8">
				<Stat
					value={String(techCount).padStart(2, "0")}
					label="Tecnologías"
					detail={`Principales: ${TECH_META.React.label}, ${TECH_META.NodeJs.label}, ${TECH_META.PostgreSQL.label}`}
				/>
			</div>
		</div>

		<Section index="01" eyebrow="Stack" title="Tecnologías" class="pb-20 lg:pb-28">
			<Stack />
		</Section>
	</div>
</Layout>