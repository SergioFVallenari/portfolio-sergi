---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { SITE } from "../data/site";

const channels = [
	{ label: "Email", href: `mailto:${SITE.email}`, value: SITE.email },
	{
		label: "LinkedIn",
		href: "https://www.linkedin.com/in/sergiovallenari",
		value: "/in/sergiovallenari",
	},
	{
		label: "GitHub",
		href: "https://github.com/SergioFVallenari",
		value: "@SergioFVallenari",
	},
];
---

<Layout
	title="Contacto | Sergio Vallenari"
	description="Contacto de Sergio Vallenari: email, LinkedIn, GitHub y CV descargable para oportunidades de Full Stack Developer."
>
	<div class="mx-auto max-w-shell px-5 sm:px-8">
		<header class="pb-10 pt-14 sm:pt-20 lg:pb-14 lg:pt-28">
			<p
				class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-mute"
			>
				<span class="text-accent">Contacto</span> — escribime cuando quieras
			</p>
			<h1
				transition:name="page-title"
				class="mt-6 max-w-[20ch] text-balance text-[clamp(2.5rem,6vw,4.5rem)] font-semibold leading-[0.98] tracking-[-0.035em] text-ink"
			>
				Escribime y hablamos
			</h1>
		</header>

		<Section class="pb-20 lg:pb-28">
			<div class="grid gap-12 lg:grid-cols-12">
				<div class="lg:col-span-7">
					<p class="max-w-prose text-lg leading-relaxed text-ink-soft">
						¿Tenés una propuesta, una búsqueda activa o simplemente querés
						hablar de tecnología? Escribime y te respondo.
					</p>
					<a
						href={`mailto:${SITE.email}`}
						class="mt-8 block break-all text-[clamp(1.75rem,5vw,3.25rem)] font-semibold leading-tight tracking-[-0.03em] text-ink transition-colors duration-300 hover:text-accent"
					>
						{SITE.email}
					</a>
					<div class="mt-10 flex flex-wrap items-center gap-8 border-t border-line pt-6">
						<ArrowLink href={SITE.cv} external>Descargar CV</ArrowLink>
						<ArrowLink href="/proyectos">Ver proyectos</ArrowLink>
					</div>
				</div>

				<div class="lg:col-span-4 lg:col-start-9">
					<p
						class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-mute"
					>
						Otros canales
					</p>
					<ul class="mt-6 flex flex-col border-t border-line">
						{
							channels.map((channel) => (
								<li class="border-b border-line">
									<a
										href={channel.href}
										target={channel.href.startsWith("mailto:") ? undefined : "_blank"}
										rel="noopener noreferrer"
										class="group flex items-baseline justify-between gap-4 py-4 transition-colors"
									>
										<span class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-mute">
											{channel.label}
										</span>
										<span class="flex items-center gap-2 text-sm text-ink transition-colors group-hover:text-accent">
											{channel.value}
											<span aria-hidden="true" class="text-xs">↗</span>
										</span>
									</a>
								</li>
							))
						}
					</ul>
					<p
						class="mt-6 flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.16em] text-ink-mute"
					>
						<span class="size-1.5 rounded-full bg-available"></span>
						{SITE.availability}
					</p>
				</div>
			</div>
		</Section>
	</div>
</Layout>