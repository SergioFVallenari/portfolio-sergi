---
import Wordmark from "./Wordmark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import ArrowLink from "./ArrowLink.astro";
import { SITE } from "../data/site";

const pathname = Astro.url.pathname.replace(/\/+$/, "");
const isActive = (href: string) => href.replace(/\/+$/, "") === pathname;
---

<header
	transition:name="site-header"
	class="sticky top-0 z-50 border-b border-line bg-paper/80 backdrop-blur-md"
>
	<div
		class="mx-auto flex h-16 max-w-shell items-center justify-between gap-6 px-5 sm:px-8"
	>
		<Wordmark />

		<nav class="hidden items-center gap-7 md:flex" aria-label="Principal">
			{
				SITE.nav.map((item) => (
					<a
						href={item.href}
						aria-current={isActive(item.href) ? "page" : undefined}
						class:list={[
							"border-b pb-0.5 text-sm transition-colors",
							isActive(item.href)
								? "border-accent text-ink"
								: "border-transparent text-ink-mute hover:border-line hover:text-ink",
						]}
					>
						{item.title}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-1">
			<ThemeToggle />
			<button
				id="menu-toggle"
				type="button"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="drawer"
				class="-mr-2 inline-flex size-9 items-center justify-center text-ink transition-colors hover:text-accent md:hidden"
			>
				<svg
					class="size-5"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path id="menu-icon-open" d="M3 7h18M3 17h18"></path>
				</svg>
			</button>
		</div>
	</div>
</header>

<div
	id="drawer"
	aria-hidden="true"
	class="invisible fixed inset-0 z-40 opacity-0 transition-[opacity,visibility] duration-300 md:hidden"
>
	<div class="absolute inset-0 bg-ink/40 backdrop-blur-sm" data-drawer-overlay></div>
	<div
		class="absolute inset-x-0 top-0 border-b border-line bg-paper px-5 pb-10 pt-20 sm:px-8"
	>
		<nav class="flex flex-col" aria-label="Menú">
			{
				SITE.nav.map((item, index) => (
					<a
						href={item.href}
						aria-current={isActive(item.href) ? "page" : undefined}
						class:list={[
							"flex items-baseline justify-between border-b border-line py-4 text-2xl font-medium tracking-[-0.02em] transition-colors",
							isActive(item.href) ? "text-accent" : "text-ink",
						]}
					>
						{item.title}
						<span class="font-mono text-[11px] tracking-[0.18em] text-ink-mute">
							{String(index + 1).padStart(2, "0")}
						</span>
					</a>
				))
			}
		</nav>
		<div class="mt-8 flex flex-wrap items-center gap-6">
			<ArrowLink href={`mailto:${SITE.email}`} external>Email</ArrowLink>
			<ArrowLink href="https://github.com/SergioFVallenari" external
				>GitHub</ArrowLink
			>
		</div>
	</div>
</div>

<script is:inline>
	(function () {
		let toggle = null;
		let drawer = null;
		let icon = null;

		function open() {
			if (!toggle || !drawer) return;
			drawer.classList.remove("invisible", "opacity-0");
			drawer.setAttribute("aria-hidden", "false");
			toggle.setAttribute("aria-expanded", "true");
			toggle.setAttribute("aria-label", "Cerrar menú");
			document.body.style.overflow = "hidden";
			icon?.setAttribute("d", "M6 6l12 12M18 6L6 18");
			drawer.querySelector("a")?.focus();
		}

		function close() {
			if (!toggle || !drawer) return;
			drawer.classList.add("invisible", "opacity-0");
			drawer.setAttribute("aria-hidden", "true");
			toggle.setAttribute("aria-expanded", "false");
			toggle.setAttribute("aria-label", "Abrir menú");
			document.body.style.overflow = "";
			icon?.setAttribute("d", "M3 7h18M3 17h18");
		}

		function initMenu() {
			const nextToggle = document.getElementById("menu-toggle");
			const nextDrawer = document.getElementById("drawer");
			if (!nextToggle || !nextDrawer || nextToggle === toggle) return;

			toggle = nextToggle;
			drawer = nextDrawer;
			icon = document.getElementById("menu-icon-open");

			toggle.addEventListener("click", function () {
				if (toggle.getAttribute("aria-expanded") === "true") {
					close();
				} else {
					open();
				}
			});

			drawer
				.querySelector("[data-drawer-overlay]")
				?.addEventListener("click", close);

			drawer.addEventListener("click", function (event) {
				if (event.target instanceof Element && event.target.closest("a"))
					close();
			});
		}

		document.addEventListener("keydown", function (event) {
			if (event.key === "Escape") close();
		});

		window.addEventListener("resize", function () {
			if (window.innerWidth >= 768) close();
		});

		document.addEventListener("astro:before-swap", close);
		document.addEventListener("astro:page-load", initMenu);

		initMenu();
	})();
</script>