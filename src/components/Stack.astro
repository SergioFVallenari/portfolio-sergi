---
import { STACK } from "../data/stack";
import TechTag from "./TechTag.astro";
---

<div class="grid gap-y-14 sm:grid-cols-2 sm:gap-x-16">
	{
		STACK.map((category) => (
			<div>
				<h3 class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-mute">
					{category.title}
				</h3>
				<ul class="mt-6 flex flex-col">
					{category.items.map((item) => (
						<li class="flex items-center border-b border-line py-3 text-sm first:border-t">
							<TechTag tech={item.tech} />
						</li>
					))}
				</ul>
			</div>
		))
	}
</div>