---
const label = "Cambiar tema";
---

<button
	id="theme-toggle"
	type="button"
	aria-label={label}
	class="-mr-1 inline-flex size-9 items-center justify-center text-ink transition-colors hover:text-accent"
>
	<svg
		class="icon-sun size-[18px] transition-transform duration-300 hover:rotate-45"
		viewBox="0 0 24 24"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4" />
		<path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
	</svg>
	<svg
		class="icon-moon hidden size-[18px] transition-transform duration-300 hover:-rotate-12"
		viewBox="0 0 24 24"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
	</svg>
</button>

<script is:inline>
	(function () {
		function syncIcons(toggle) {
			const dark = document.documentElement.classList.contains("dark");
			toggle
				.querySelector(".icon-sun")
				?.classList.toggle("hidden", dark);
			toggle
				.querySelector(".icon-moon")
				?.classList.toggle("hidden", !dark);
			toggle.setAttribute(
				"aria-label",
				dark ? "Cambiar a modo claro" : "Cambiar a modo oscuro",
			);
		}

		function initTheme() {
			const toggle = document.getElementById("theme-toggle");
			if (!toggle || toggle.dataset.ready === "true") return;
			toggle.dataset.ready = "true";

			syncIcons(toggle);

			toggle.addEventListener("click", function () {
				const dark = document.documentElement.classList.toggle("dark");
				try {
					localStorage.setItem("theme", dark ? "dark" : "light");
				} catch (e) {}
				syncIcons(toggle);
			});
		}

		initTheme();
		document.addEventListener("astro:page-load", initTheme);
	})();
</script>