---
import { TECH_META, type TechKey } from "../data/tech";
import JavascriptIcon from "./Icons/JavascriptIcon.astro";
import TypescriptIcon from "./Icons/TypescriptIcon.astro";
import ReactIcon from "./Icons/ReactIcon.astro";
import ReduxIcons from "./Icons/ReduxIcons.astro";
import TailwindIcon from "./Icons/TailwindIcon.astro";
import HtmlIcon from "./Icons/HtmlIcon.astro";
import CssIcon from "./Icons/CssIcon.astro";
import Angular from "./Icons/Angular.astro";
import NodejsIcon from "./Icons/NodejsIcon.astro";
import ExpressIcon from "./Icons/ExpressIcon.astro";
import PhpIcon from "./Icons/PhpIcon.astro";
import SequelizeIcon from "./Icons/SequelizeIcon.astro";
import MySqlIcon from "./Icons/MySqlIcon.astro";
import PostgreIcon from "./Icons/PostgreIcon.astro";
import FirebaseIcon from "./Icons/FirebaseIcon.astro";
import GoogleCloudIcon from "./Icons/GoogleCloudIcon.astro";
import AstroIcon from "./Icons/AstroIcon.astro";
import CapacitorIcon from "./Icons/CapacitorIcon.astro";
import CodeIcon from "./Icons/CodeIcon.astro";

const ICONS: Partial<Record<TechKey, typeof ReactIcon>> = {
	Javascript: JavascriptIcon,
	Typescript: TypescriptIcon,
	GoogleCloud: GoogleCloudIcon,
	FirebaseStorage: FirebaseIcon,
	Firebase: FirebaseIcon,
	Sequelize: SequelizeIcon,
	Capacitor: CapacitorIcon,
	PostgreSQL: PostgreIcon,
	Html: HtmlIcon,
	Express: ExpressIcon,
	NodeJs: NodejsIcon,
	Tailwind: TailwindIcon,
	MySql: MySqlIcon,
	Redux: ReduxIcons,
	React: ReactIcon,
	Astro: AstroIcon,
	Angular: Angular,
	Css: CssIcon,
	Php: PhpIcon,
};

interface Props {
	tech: TechKey;
	variant?: "row" | "icon";
	size?: string;
}

const { tech, variant = "row", size = "size-4" } = Astro.props;

const { label } = TECH_META[tech];
const Icon = ICONS[tech] ?? CodeIcon;
---

<span class="inline-flex items-center gap-2.5">
	<Icon class={`${size} shrink-0 grayscale transition-all duration-300 hover:grayscale-0`} />
	{variant === "row" && <span class="text-ink">{label}</span>}
</span>