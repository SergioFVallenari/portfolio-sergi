---
import type { Experience } from "../data/experience";

const { date, title, description, link, other } = Astro.props as Experience;

const [role, company] = title.split("-").map((part) => part.trim());
---

<div class="lg:col-span-3">
	<p
		class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-mute"
	>
		{date}
	</p>
	{other && (
		<p
			class="mt-2 font-mono text-[11px] uppercase tracking-[0.14em] text-accent"
		>
			{other}
		</p>
	)}
</div>

<div class="lg:col-span-7">
	<h2 class="text-xl font-semibold tracking-[-0.02em] text-ink">
		{role}
		{company && <span class="text-ink-mute">— {company}</span>}
	</h2>
	{description && (
		<p class="mt-3 max-w-prose text-[15px] leading-relaxed text-ink-soft">
			{description}
		</p>
	)}
</div>

{
	link && (
		<div class="lg:col-span-2 lg:text-right">
			<a
				href={link}
				target="_blank"
				rel="noopener noreferrer"
				class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-mute transition-colors hover:text-accent"
			>
				{company || role} <span aria-hidden="true">↗</span>
			</a>
		</div>
	)
}