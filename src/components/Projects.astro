---
import { PROJECTS, type ProjectKind } from "../data/projects";
import { TECH_META } from "../data/tech";

interface Props {
	kind: ProjectKind;
}

const { kind } = Astro.props;

const items = PROJECTS.filter((project) => project.kind === kind);

const index = (value: number) => String(value).padStart(2, "0");

const blocks = (text: string) =>
	text
		.split(/\n\s*\n/)
		.map((block) => block.trim())
		.filter(Boolean);
---

<ul class="grid gap-x-10 gap-y-16 md:grid-cols-2">
	{
		items.map((project, position) => {
			const paragraphs = blocks(project.description);
			const note = blocks(project.other ?? "");

			return project.draft ? (
				<li class="flex flex-col justify-center border border-dashed border-line px-6 py-12">
					<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-accent">
						Pendiente
					</p>
					<h2 class="mt-3 text-xl font-semibold tracking-[-0.02em] text-ink">
						{project.title}
					</h2>
					<div class="mt-2 space-y-3 text-sm leading-relaxed text-ink-mute">
						{paragraphs.map((paragraph) => (
							<p class="whitespace-pre-line">{paragraph}</p>
						))}
					</div>
				</li>
			) : (
				<li class="group flex flex-col">
					<div class="flex justify-center">
						<img
							src={project.image}
							alt={project.title}
							loading="lazy"
							class="max-h-[26rem] max-w-full border border-line object-contain transition-transform duration-700 ease-out group-hover:scale-[1.03]"
						/>
					</div>

					<div class="mt-5 flex items-baseline justify-between gap-4">
						<span class="font-mono text-[11px] tracking-[0.18em] text-accent">
							{index(position + 1)}
						</span>
						{project.technologies.length > 0 && (
							<p class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-mute">
								{project.technologies
									.slice(0, 3)
									.map((tech) => TECH_META[tech].label)
									.join(" · ")}
							</p>
						)}
					</div>

					<h2 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-ink transition-colors duration-300 group-hover:text-accent">
						{project.title}
					</h2>

					<div class="mt-3 space-y-3 text-[15px] leading-relaxed text-ink-soft">
						{paragraphs.map((paragraph) => (
							<p class="whitespace-pre-line">{paragraph}</p>
						))}
					</div>

					{note.length > 0 && (
						<div class="mt-5 space-y-3 border-l border-line pl-4 text-sm leading-relaxed text-ink-mute">
							{note.map((paragraph) => (
								<p class="whitespace-pre-line">{paragraph}</p>
							))}
						</div>
					)}

					<div class="mt-6 flex flex-wrap gap-6 border-t border-line pt-4">
						{project.github && (
							<a
								href={project.github}
								target="_blank"
								rel="noopener noreferrer"
								class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-mute transition-colors hover:text-accent"
							>
								Repositorio <span aria-hidden="true">↗</span>
							</a>
						)}
						{project.demo && (
							<a
								href={project.demo}
								target="_blank"
								rel="noopener noreferrer"
								class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-mute transition-colors hover:text-accent"
							>
								Demo <span aria-hidden="true">↗</span>
							</a>
						)}
					</div>
				</li>
			);
		})
	}
</ul>