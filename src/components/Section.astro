---
interface Props {
	index?: string;
	eyebrow?: string;
	title?: string;
	id?: string;
	class?: string;
}

const { index, eyebrow, title, id, class: className = "" } = Astro.props;
const hasHeader = Boolean(eyebrow || title);
---

<section id={id} class={`border-t border-line ${className}`}>
	{
		hasHeader && (
			<div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 pt-6">
				{eyebrow && (
					<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-mute">
						{index && <span class="text-accent">{index}</span>}
						{index && " / "}
						{eyebrow}
					</p>
				)}
				{title && (
					<h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
						{title}
					</h2>
				)}
			</div>
		)
	}
	<div class={hasHeader ? "pt-8 lg:pt-10" : ""}>
		<slot />
	</div>
</section>